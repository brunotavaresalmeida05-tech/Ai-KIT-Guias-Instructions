# Runtime configuration. All defaults work offline for local development.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# Required in production: generate a random secret of at least 32 characters.
# API_KEY=
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# External rate limit server (Python FastAPI service on port 8080)
# ENABLE_EXTERNAL_RATE_LIMIT=true
# RATE_LIMIT_SERVER_URL=http://localhost:8080

# memory is volatile. json is single-process. sqlite persists locally.
MEMORY_BACKEND=memory
MEMORY_PATH=data/memory.json
SQLITE_PATH=data/memory.db
DATA_DIR=data
# DATABASE_URL=postgresql://ai_user:YOUR_PASSWORD@localhost:5432/ai_dev

EMBEDDING_PROVIDER=hash
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK=openai,anthropic,ollama
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_LLM_MODEL=mistral
OTEL_ENABLED=false
# SKILLS_DIR=skills

# Optional Docker Compose development services; never production credentials.
DB_USER=ai_user
DB_PASSWORD=dev-only-change-me
DB_NAME=ai_dev
DB_PORT=5432
GRAFANA_PASSWORD=dev-only-change-me
