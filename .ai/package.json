{
  "name": "ai-development-system",
  "version": "2.1.0",
  "description": "Universal AI-assisted development system with multi-agent orchestration, HTTP API and CLI",
  "main": "dist/server.js",
  "bin": {
    "ai-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "config",
    "db",
    "examples",
    "recipes",
    "templates",
    "docs",
    "AGENTS.md",
    "README.md",
    "INDEX.md",
    "QUICKSTART.md",
    "LICENSE",
    ".env.example",
    "agents"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --exec ts-node --files src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "cli": "ts-node --files src/cli.ts",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config jest.config.js tests/integration.test.ts --runInBand",
    "test:all": "npm test",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "example:code-review": "ts-node --files examples/01-multi-agent-workflow.ts",
    "example:monitoring": "ts-node --files examples/02-realtime-monitoring.ts",
    "example:data-pipeline": "ts-node --files examples/03-data-pipeline.ts",
    "example:notifications": "ts-node --files examples/04-notifications-with-actions.ts",
    "examples:all": "npm run example:code-review && npm run example:monitoring && npm run example:data-pipeline && npm run example:notifications",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup": "node scripts/setup.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:trivy": "trivy fs . --severity HIGH,CRITICAL --exit-code 1",
    "security:gitleaks": "gitleaks detect --source=. --verbose",
    "security:depcheck": "dependency-check --project ai-kit --scan . --failOnCVSS 7",
    "security:license": "license-checker --failOn GPLv3,AGPL,LGPLv3,MPL-2.0,SSPl-1.0",
    "security:all": "npm run security:audit && npm run security:trivy && npm run security:gitleaks && npm run security:depcheck",
    "test:ts": "npm test",
    "check": "npm run type-check && npm run lint && npm run test:coverage -- --runInBand && npm run build && npm run cli -- validate",
    "hooks:install": "husky"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "ajv": "^8.12.0",
    "axios": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "p-queue": "^6.6.2",
    "pg": "^8.10.0",
    "pino": "^8.14.1",
    "redis": "^4.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "eslint": "^8.43.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "license-checker": "^25.0.0",
    "lint-staged": "^15.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^2.8.8",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "gitleaks protect --staged --verbose"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
