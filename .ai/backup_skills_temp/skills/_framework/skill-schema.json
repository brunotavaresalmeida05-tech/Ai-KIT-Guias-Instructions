{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Taste-Skill Schema",
  "description": "Universal schema for all Taste-Skills in the V2.0 system",
  "type": "object",
  "required": [
    "name",
    "version",
    "category",
    "description",
    "tags",
    "when_to_use",
    "input",
    "output",
    "execution_time"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique skill identifier (kebab-case)"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "category": {
      "type": "string",
      "enum": [
        "development",
        "testing",
        "security",
        "documentation",
        "deployment",
        "analysis",
        "research",
        "architecture",
        "code-quality",
        "devops",
        "database",
        "api",
        "frontend",
        "backend",
        "infrastructure"
      ],
      "description": "Skill category for organization"
    },
    "author": {
      "type": "string",
      "description": "Author name"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Creation date"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last update date"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "What this skill does"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "minItems": 1,
      "maxItems": 10,
      "description": "Search tags for skill discovery"
    },
    "when_to_use": {
      "type": "string",
      "minLength": 10,
      "description": "When to use this skill"
    },
    "when_not_to_use": {
      "type": "string",
      "description": "When NOT to use this skill"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prerequisites for using this skill"
    },
    "input": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      },
      "description": "Input schema (JSON Schema)"
    },
    "output": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      },
      "description": "Output schema (JSON Schema)"
    },
    "execution_time": {
      "type": "object",
      "required": ["min_seconds", "max_seconds", "typical_seconds"],
      "properties": {
        "min_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_seconds": {
          "type": "number",
          "minimum": 0
        },
        "typical_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "description": "Execution time estimates"
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "memory_mb": {
          "type": "number",
          "minimum": 0
        },
        "disk_mb": {
          "type": "number",
          "minimum": 0
        },
        "network": {
          "type": "boolean"
        }
      },
      "description": "Resource requirements"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dependent skills"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Criteria for successful execution"
    },
    "error_handling": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["error", "cause", "solution"],
        "properties": {
          "error": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          }
        }
      },
      "description": "Common errors and solutions"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "input"],
        "properties": {
          "name": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "expected_output": {
            "type": "object"
          }
        }
      },
      "description": "Usage examples"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string"
          },
          "how": {
            "type": "string"
          }
        }
      },
      "description": "Integration points"
    },
    "related_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related skills"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes and tips"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date"],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Version history"
    }
  },
  "additionalProperties": false
}
